<div class="section" id="quiz">
  <h2 class="section-title">Latihan Soal UKMPPD — Anorektal</h2>
  <p class="section-desc">10 soal tipe CBT bergaya UKMPPD — materi Hemoroid, Abses, Fistula, Prolaps, Proktitis, dan Alur Diagnosis.</p>

  <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
  <div class="progress-text" id="progressText">0 / 10 dijawab</div>

  <!-- Q1 -->
  <div class="quiz-card" id="q1">
    <div class="quiz-num">Soal 1</div>
    <div class="quiz-vignette">Seorang laki-laki 35 tahun datang dengan keluhan BAB berdarah merah segar, menetes setelah BAB, tidak nyeri, sejak 3 bulan. Riwayat konstipasi kronik. Pemeriksaan: inspeksi perianal normal. Colok dubur tidak teraba massa. Anoskopi: tampak bantalan vaskular membesar di atas linea dentata, belum ada prolaps.</div>
    <p class="quiz-question">Apakah diagnosis dan tatalaksana yang paling tepat?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q1',false,'A')"><span class="opt-letter">A</span>Hemoroid eksterna — eksisi</button>
      <button class="quiz-option" onclick="answer(this,'q1',true,'B')"><span class="opt-letter">B</span>Hemoroid interna grade 1 — modifikasi diet + venotonik</button>
      <button class="quiz-option" onclick="answer(this,'q1',false,'C')"><span class="opt-letter">C</span>Hemoroid interna grade 3 — rubber band ligation</button>
      <button class="quiz-option" onclick="answer(this,'q1',false,'D')"><span class="opt-letter">D</span>Hemoroid interna grade 4 — hemoroidektomi</button>
      <button class="quiz-option" onclick="answer(this,'q1',false,'E')"><span class="opt-letter">E</span>Fisura ani — salep nitrat</button>
    </div>
    <div class="explanation" id="exp-q1">✅ <strong>B. Hemoroid Interna Grade 1 — Modifikasi diet + venotonik</strong><br><br>
    Kunci grade: hemoroid terlihat di anoskopi tapi <strong>belum ada prolaps</strong> = Grade 1. Tatalaksana grade 1 = <strong>konservatif</strong>: diet tinggi serat, banyak minum, venotonik (diosmin-hesperidin), pelunak tinja. <strong>Kompetensi 4A</strong> → dokter umum bisa tangani sendiri.<br><br>
    ❌ Grade 3 = prolaps saat mengejan, bisa masuk dengan jari → RBL. ❌ Grade 4 = prolaps menetap → operasi. ❌ Fisura = nyeri hebat saat BAB.</div>
  </div>

  <!-- Q2 -->
  <div class="quiz-card" id="q2">
    <div class="quiz-num">Soal 2</div>
    <div class="quiz-vignette">Seorang perempuan 28 tahun datang ke IGD dengan nyeri hebat di dubur mendadak sejak tadi pagi setelah habis BAB keras. Tidak ada demam. Dari inspeksi perianal: tampak benjolan biru-ungu sebesar kelereng di pinggir anus kanan, keras, nyeri tekan (+). Colok dubur tidak dilakukan karena nyeri sangat berat.</div>
    <p class="quiz-question">Apakah diagnosis dan penanganan yang paling tepat pada kasus ini?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q2',false,'A')"><span class="opt-letter">A</span>Abses perianal — insisi drainase segera</button>
      <button class="quiz-option" onclick="answer(this,'q2',true,'B')"><span class="opt-letter">B</span>Trombosis hemoroid eksterna — eksisi &lt;72 jam</button>
      <button class="quiz-option" onclick="answer(this,'q2',false,'C')"><span class="opt-letter">C</span>Hemoroid interna grade 4 — hemoroidektomi</button>
      <button class="quiz-option" onclick="answer(this,'q2',false,'D')"><span class="opt-letter">D</span>Prolaps rektum — reduksi manual</button>
      <button class="quiz-option" onclick="answer(this,'q2',false,'E')"><span class="opt-letter">E</span>Fisura ani — salep CCB</button>
    </div>
    <div class="explanation" id="exp-q2">✅ <strong>B. Trombosis Hemoroid Eksterna — Eksisi &lt;72 jam</strong><br><br>
    Kunci: benjolan <strong>biru-ungu</strong> di <strong>pinggir anus</strong> (di bawah linea dentata = eksterna) + nyeri <strong>hebat mendadak</strong> + tidak ada demam. Ini adalah trombosis hemoroid eksterna. Karena &lt;72 jam, pilihan terbaik adalah <strong>eksisi torombus</strong> di poli bedah (anestesi lokal) → nyeri langsung reda. Jika &gt;72 jam → konservatif (sitz bath, analgesik, venotonik) karena trombus sudah mulai resolusi.<br><br>
    ❌ Abses = ada demam + fluktuasi + eritema. ❌ Prolaps rektum = benjolan besar, cincin konsentrik, bukan biru-ungu kecil.</div>
  </div>

  <!-- Q3 -->
  <div class="quiz-card" id="q3">
    <div class="quiz-num">Soal 3</div>
    <div class="quiz-vignette">Seorang laki-laki 32 tahun datang dengan keluhan keluar nanah berbau dari lubang kecil di kulit perianal kanan sejak 2 bulan. Riwayat 4 bulan lalu pernah operasi insisi drainase abses di dubur. Tidak ada demam saat ini. Pemeriksaan: tampak opening eksternal di posisi jam 5 (posterior-lateral kanan), teraba traktus seperti tali menuju anus.</div>
    <p class="quiz-question">Apakah diagnosis yang paling tepat dan kompetensi SKDI-nya?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q3',false,'A')"><span class="opt-letter">A</span>Abses perianal rekuren — SKDI 3A, insisi drainase</button>
      <button class="quiz-option" onclick="answer(this,'q3',true,'B')"><span class="opt-letter">B</span>Fistula ani — SKDI 2, rujuk ke Sp.B</button>
      <button class="quiz-option" onclick="answer(this,'q3',false,'C')"><span class="opt-letter">C</span>Fistula ani — SKDI 3A, fistulotomi di FKTP</button>
      <button class="quiz-option" onclick="answer(this,'q3',false,'D')"><span class="opt-letter">D</span>Kista pilonidal — SKDI 2, eksisi di Sp.B</button>
      <button class="quiz-option" onclick="answer(this,'q3',false,'E')"><span class="opt-letter">E</span>Hidradenitis supurativa — antibiotik jangka panjang</button>
    </div>
    <div class="explanation" id="exp-q3">✅ <strong>B. Fistula Ani — SKDI 2, rujuk ke Sp.B</strong><br><br>
    Fistula ani adalah <strong>sekuel abses anorektal</strong> (90% kasus). Riwayat abses + operasi drainase + discharge purulen kronik dari opening eksternal + traktus teraba seperti tali → <strong>fistula ani</strong>. Kompetensi SKDI = <strong>2</strong> → dokter umum hanya diagnosis + rujuk, tidak boleh melakukan fistulotomi sendiri.<br><br>
    ❌ Kista pilonidal = di garis tengah sakrokoksigeus (bukan perianal), sering pada pria berbulu. ❌ Hidradenitis supurativa = multipel sinus di berbagai lokasi (ketiak, selangkangan, perianal).</div>
  </div>

  <!-- Q4 -->
  <div class="quiz-card" id="q4">
    <div class="quiz-num">Soal 4</div>
    <div class="quiz-vignette">Seorang perempuan 55 tahun datang dengan keluhan benjolan di dubur yang keluar saat BAB sudah 2 tahun. Awalnya bisa masuk sendiri, sekarang harus dibantu tangan. Sering merasa tidak tuntas BAB. Ada inkontinensia alvi ringan. Dari pemeriksaan saat pasien diminta mengejan: tampak benjolan besar dengan lipatan-lipatan konsentrik melingkar.</div>
    <p class="quiz-question">Apakah diagnosis yang paling tepat dan perbedaan kunci dengan hemoroid prolaps?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q4',false,'A')"><span class="opt-letter">A</span>Hemoroid interna grade 4 — lipatan konsentrik</button>
      <button class="quiz-option" onclick="answer(this,'q4',true,'B')"><span class="opt-letter">B</span>Prolaps rektum grade 3 — lipatan konsentrik (hemoroid = radial)</button>
      <button class="quiz-option" onclick="answer(this,'q4',false,'C')"><span class="opt-letter">C</span>Prolaps mukosa rektum — hanya mukosa yang keluar</button>
      <button class="quiz-option" onclick="answer(this,'q4',false,'D')"><span class="opt-letter">D</span>Hemoroid interna grade 3 — bisa masuk dengan jari</button>
      <button class="quiz-option" onclick="answer(this,'q4',false,'E')"><span class="opt-letter">E</span>Polip rektum prolaps — keras, tidak nyeri</button>
    </div>
    <div class="explanation" id="exp-q4">✅ <strong>B. Prolaps Rektum Grade 3 — Lipatan Konsentrik</strong><br><br>
    Dua kunci diagnosis: (1) Lipatan <strong>KONSENTRIK</strong> = prolaps rektum (seluruh lapisan dinding); (2) Grade 3 = prolaps saat mengejan, perlu <strong>dimasukkan manual</strong>.<br><br>
    <strong>Pembeda utama Prolaps Rektum vs Hemoroid Prolaps:</strong><br>
    ✓ Prolaps rektum = lipatan <strong>KONSENTRIK</strong> (melingkar)<br>
    ✓ Hemoroid prolaps = lipatan <strong>RADIAL</strong> (seperti jari-jari roda)<br><br>
    ❌ Grade 4 = tidak bisa masuk sama sekali. ❌ Polip = keras, permukaan irregular.</div>
  </div>

  <!-- Q5 -->
  <div class="quiz-card" id="q5">
    <div class="quiz-num">Soal 5</div>
    <div class="quiz-vignette">Seorang laki-laki 25 tahun datang dengan demam 38,8°C, nyeri berdenyut di dubur sejak 5 hari, sulit duduk dan sulit BAB. Pemeriksaan: tampak bengkak merah di perianal kanan, nyeri tekan hebat, fluktuatif. Tidak ada riwayat DM.</div>
    <p class="quiz-question">Apakah tatalaksana yang paling tepat dan yang TIDAK BOLEH dilakukan?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q5',false,'A')"><span class="opt-letter">A</span>Antibiotik oral saja selama 7 hari</button>
      <button class="quiz-option" onclick="answer(this,'q5',false,'B')"><span class="opt-letter">B</span>Antibiotik IV + observasi 48 jam</button>
      <button class="quiz-option" onclick="answer(this,'q5',true,'C')"><span class="opt-letter">C</span>Insisi dan drainase segera (antibiotik saja tidak cukup)</button>
      <button class="quiz-option" onclick="answer(this,'q5',false,'D')"><span class="opt-letter">D</span>Sitz bath + analgesik + rujuk 1 minggu</button>
      <button class="quiz-option" onclick="answer(this,'q5',false,'E')"><span class="opt-letter">E</span>CT scan pelvis sebelum tindakan</button>
    </div>
    <div class="explanation" id="exp-q5">✅ <strong>C. Insisi dan Drainase Segera</strong><br><br>
    Abses perianal = <strong>insisi dan drainase</strong> adalah tatalaksana utama. <strong>Antibiotik saja TIDAK CUKUP</strong> — pus tidak bisa dieliminasi dengan antibiotik, harus dikeluarkan secara fisik. Jika hanya antibiotik → abses akan rekuren dan risiko pembentukan fistula makin tinggi.<br><br>
    Risiko jika tidak ditangani: sepsis, fistula ani (30–50%), Fournier gangrene pada pasien DM/imunokompromais. Abses perianal superfisial bisa di-drain dengan anestesi lokal di poli/IGD; abses dalam (iskiorektal, supralevator) perlu anestesi spinal/umum di OK.</div>
  </div>

  <!-- Q6 -->
  <div class="quiz-card" id="q6">
    <div class="quiz-num">Soal 6</div>
    <div class="quiz-vignette">Seorang laki-laki 30 tahun dengan riwayat anal seks datang dengan keluhan tenesmus, nyeri rektal, dan diare berlendir darah sejak 1 minggu. Pemeriksaan colok dubur: nyeri tekan, sarung tangan: lendir purulen (+). Proktoskopi: mukosa hiperemis, edematosa, mudah berdarah.</div>
    <p class="quiz-question">Apakah diagnosis dan pemeriksaan penunjang yang paling tepat untuk konfirmasi?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q6',false,'A')"><span class="opt-letter">A</span>Hemoroid interna — anoskopi + grading</button>
      <button class="quiz-option" onclick="answer(this,'q6',false,'B')"><span class="opt-letter">B</span>Kolitis ulseratif — kolonoskopi + biopsi</button>
      <button class="quiz-option" onclick="answer(this,'q6',true,'C')"><span class="opt-letter">C</span>Proktitis infeksi (gonore/klamidia) — swab PCR/kultur</button>
      <button class="quiz-option" onclick="answer(this,'q6',false,'D')"><span class="opt-letter">D</span>Fistula ani — MRI pelvis</button>
      <button class="quiz-option" onclick="answer(this,'q6',false,'E')"><span class="opt-letter">E</span>Ca rektum — biopsi</button>
    </div>
    <div class="explanation" id="exp-q6">✅ <strong>C. Proktitis Infeksi (Gonore/Klamidia) — Swab PCR/Kultur</strong><br><br>
    Kunci: (1) Riwayat <strong>anal seks</strong> — ini trigger utama proktitis infeksi; (2) Gejala: tenesmus + nyeri rektal + diare lendir purulen; (3) Proktoskopi: mukosa hiperemis, edema. Pemeriksaan konfirmasi = <strong>swab anorektal PCR/kultur</strong> untuk N. gonorrhoeae dan C. trachomatis.<br><br>
    Tatalaksana: Seftriakson 500mg IM + Azitromisin 1g oral (sesuai panduan IMS). ❌ Kolitis ulseratif = lebih kronis, tidak ada riwayat seks anal. ❌ Ca rektum = massa keras, tidak ada discharge akut.</div>
  </div>

  <!-- Q7 -->
  <div class="quiz-card" id="q7">
    <div class="quiz-num">Soal 7</div>
    <div class="quiz-vignette">Seorang laki-laki 50 tahun datang dengan BAB berdarah merah segar + lendir sejak 3 bulan, disertai penurunan berat badan 5 kg tidak disengaja, dan perubahan pola BAB menjadi lebih sering dengan konsistensi lebih encer. Tidak ada nyeri dubur. Colok dubur: massa keras, irregular, di dinding rektum posterior.</div>
    <p class="quiz-question">Apakah langkah diagnostik yang paling tepat selanjutnya?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q7',false,'A')"><span class="opt-letter">A</span>Terapi hemoroid konservatif dulu selama 4 minggu</button>
      <button class="quiz-option" onclick="answer(this,'q7',false,'B')"><span class="opt-letter">B</span>USG abdomen</button>
      <button class="quiz-option" onclick="answer(this,'q7',true,'C')"><span class="opt-letter">C</span>Kolonoskopi + biopsi</button>
      <button class="quiz-option" onclick="answer(this,'q7',false,'D')"><span class="opt-letter">D</span>Rubber band ligation</button>
      <button class="quiz-option" onclick="answer(this,'q7',false,'E')"><span class="opt-letter">E</span>Cek darah lengkap saja</button>
    </div>
    <div class="explanation" id="exp-q7">✅ <strong>C. Kolonoskopi + Biopsi</strong><br><br>
    Ada <strong>multiple red flags</strong>: usia &gt;45 tahun + darah + lendir + perubahan pola BAB + penurunan BB + <strong>massa keras irregular di colok dubur</strong>. Ini sangat mengarah ke <strong>adenokarsinoma rektum</strong>. Pemeriksaan definitif = <strong>kolonoskopi + biopsi</strong> untuk konfirmasi histopatologi.<br><br>
    ❌ JANGAN terapi hemoroid dulu — ada red flag yang harus dieliminasi. Keganasan kolorektal sering terlambat didiagnosis karena dikira hemoroid. "Semua perdarahan dubur bukan hemoroid sampai terbukti sebaliknya pada usia &gt;45 tahun."</div>
  </div>

  <!-- Q8 -->
  <div class="quiz-card" id="q8">
    <div class="quiz-num">Soal 8</div>
    <div class="quiz-vignette">Seorang wanita 45 tahun post-radioterapi pelvis 8 bulan lalu (karena Ca serviks stadium II) datang dengan tenesmus, diare lendir-darah, dan nyeri rektal sejak 2 bulan terakhir. Proktoskopi: mukosa rektum hiperemis, telangiektasia, mudah berdarah, tidak ada massa.</div>
    <p class="quiz-question">Apakah diagnosis yang paling tepat dan tatalaksana lini pertamanya?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q8',false,'A')"><span class="opt-letter">A</span>Rekurensi Ca serviks — kemoterapi</button>
      <button class="quiz-option" onclick="answer(this,'q8',false,'B')"><span class="opt-letter">B</span>Kolitis ulseratif — mesalamin + steroid</button>
      <button class="quiz-option" onclick="answer(this,'q8',true,'C')"><span class="opt-letter">C</span>Proktitis radiasi — mesalamin + formalin 4% topikal</button>
      <button class="quiz-option" onclick="answer(this,'q8',false,'D')"><span class="opt-letter">D</span>Proktitis infeksi — antibiotik</button>
      <button class="quiz-option" onclick="answer(this,'q8',false,'E')"><span class="opt-letter">E</span>Hemoroid interna — rubber band ligation</button>
    </div>
    <div class="explanation" id="exp-q8">✅ <strong>C. Proktitis Radiasi — Mesalamin + Formalin 4% Topikal</strong><br><br>
    Kunci: riwayat <strong>radioterapi pelvis</strong> + gejala muncul <strong>3–12 bulan post-radiasi</strong> + telangiektasia pada proktoskopi (khas proktitis radiasi). Tatalaksana: mesalamin (5-ASA), formalin 4% aplikasi topikal untuk perdarahan, oksigen hiperbarik jika tersedia. Biopsi diperlukan untuk menyingkirkan rekurensi tumor.<br><br>
    ❌ Rekurensi Ca serviks = perlu CT scan/MRI staging, tidak cukup hanya proktoskopi. ❌ Infeksi = tidak ada riwayat anal seks, tidak ada discharge purulen akut.</div>
  </div>

  <!-- Q9 -->
  <div class="quiz-card" id="q9">
    <div class="quiz-num">Soal 9</div>
    <div class="quiz-vignette">Seorang laki-laki 40 tahun datang dengan hemoroid yang sudah diketahui sejak 3 tahun. Selama ini diobati dengan modifikasi diet dan venotonik. Saat ini mengeluh hemoroid prolaps saat BAB dan harus dimasukkan manual dengan jari setiap kali. Tidak ada perdarahan aktif, tidak ada nyeri.</div>
    <p class="quiz-question">Apakah grade hemoroid dan tatalaksana yang paling tepat?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q9',false,'A')"><span class="opt-letter">A</span>Grade 2 — rubber band ligation</button>
      <button class="quiz-option" onclick="answer(this,'q9',false,'B')"><span class="opt-letter">B</span>Grade 2 — lanjutkan konservatif</button>
      <button class="quiz-option" onclick="answer(this,'q9',true,'C')"><span class="opt-letter">C</span>Grade 3 — rubber band ligation atau hemoroidektomi</button>
      <button class="quiz-option" onclick="answer(this,'q9',false,'D')"><span class="opt-letter">D</span>Grade 4 — hemoroidektomi Milligan-Morgan</button>
      <button class="quiz-option" onclick="answer(this,'q9',false,'E')"><span class="opt-letter">E</span>Grade 3 — lanjutkan konservatif saja</button>
    </div>
    <div class="explanation" id="exp-q9">✅ <strong>C. Grade 3 — Rubber Band Ligation atau Hemoroidektomi</strong><br><br>
    <strong>Grade 3</strong> = prolaps saat mengejan, <strong>perlu dimasukkan manual dengan jari</strong> (tidak bisa masuk sendiri). Grade 2 = kembali spontan sendiri. Grade 4 = tidak bisa masuk sama sekali.<br><br>
    Tatalaksana grade 3: <strong>Rubber Band Ligation (RBL)</strong> sebagai prosedur ambulatoar (efektivitas 80–90%) atau <strong>hemoroidektomi</strong> (Milligan-Morgan/Ferguson). Konservatif saja sudah tidak adekuat untuk grade 3. Kompetensi SKDI 3A → dokter umum lakukan tatalaksana awal (edukasi, analgesik, sitz bath) + rujuk untuk RBL/operasi.</div>
  </div>

  <!-- Q10 -->
  <div class="quiz-card" id="q10">
    <div class="quiz-num">Soal 10</div>
    <div class="quiz-vignette">Seorang laki-laki 38 tahun datang dengan keluhan discharge purulen dari lubang kecil di perianal kiri yang muncul tiba-tiba, disertai nyeri ringan dan gatal sejak 6 minggu. Sebelumnya tidak ada keluhan serius. Pada pemeriksaan: opening eksternal di posisi jam 9 (lateral kiri), traktus teraba menuju ke arah garis tengah posterior anus.</div>
    <p class="quiz-question">Berdasarkan Goodsall Rule, di mana letak opening internal yang paling mungkin?</p>
    <div class="quiz-options">
      <button class="quiz-option" onclick="answer(this,'q10',false,'A')"><span class="opt-letter">A</span>Di linea dentata posisi jam 9 (lateral kiri, langsung lurus)</button>
      <button class="quiz-option" onclick="answer(this,'q10',true,'B')"><span class="opt-letter">B</span>Di linea dentata garis tengah posterior (jam 6)</button>
      <button class="quiz-option" onclick="answer(this,'q10',false,'C')"><span class="opt-letter">C</span>Di linea dentata garis tengah anterior (jam 12)</button>
      <button class="quiz-option" onclick="answer(this,'q10',false,'D')"><span class="opt-letter">D</span>Tidak ada opening internal (fistula blind)</button>
      <button class="quiz-option" onclick="answer(this,'q10',false,'E')"><span class="opt-letter">E</span>Di rektum proksimal (di atas linea dentata jauh)</button>
    </div>
    <div class="explanation" id="exp-q10">✅ <strong>B. Di linea dentata garis tengah posterior (jam 6)</strong><br><br>
    <strong>Goodsall Rule:</strong><br>
    ✓ Opening eksternal di <strong>posterior</strong> (belakang garis transversal yang melintasi anus) → traktus melengkung ke garis tengah <strong>posterior</strong> (jam 6)<br>
    ✓ Opening eksternal di <strong>anterior</strong> → traktus langsung lurus ke anterior<br><br>
    Jam 9 berada di lateral — karena soal menyebut traktus menuju ke arah garis tengah posterior, ini sesuai Goodsall Rule untuk opening posterior-lateral yang kurvaturanya menuju jam 6. Penting diingat saat probing intraoperatif atau merencanakan fistulotomi.</div>
  </div>

  <!-- Score Card -->
  <div class="quiz-score-card" id="scoreCard">
    <div style="font-size:32px;margin-bottom:12px;">🎉</div>
    <div class="score-num" id="finalScore">0</div>
    <div style="font-size:18px;margin:8px 0;opacity:.8;">/ 10</div>
    <div id="scoreMessage" style="font-size:15px;opacity:.85;margin-top:8px;line-height:1.6;"></div>
    <button onclick="resetQuiz()" style="margin-top:24px;background:white;color:var(--forest);border:none;padding:12px 28px;border-radius:30px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit;">🔁 Ulangi Quiz</button>
  </div>
</div><!-- end quiz -->

</div><!-- end container -->

<button class="fab" onclick="window.print()">📥 Download PDF</button>

<script>
  function showSection(id,btn){
    document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
    document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    btn.classList.add('active');
    window.scrollTo({top:0,behavior:'smooth'});
  }
  function toggleCollapse(btn){
    btn.classList.toggle('open');
    btn.nextElementSibling.classList.toggle('open');
  }

  let score=0, answered=0;
  function answer(btn,qId,isCorrect,letter){
    const card=document.getElementById(qId);
    if(card.dataset.answered)return;
    card.dataset.answered='true';
    const allBtns=card.querySelectorAll('.quiz-option');
    allBtns.forEach(b=>{b.classList.add('disabled');b.onclick=null;});
    if(isCorrect){btn.classList.add('correct');score++;}
    else{btn.classList.add('wrong');}
    document.getElementById('exp-'+qId).classList.add('show');
    answered++;
    document.getElementById('progressText').textContent=answered+' / 10 dijawab';
    document.getElementById('progressFill').style.width=(answered*10)+'%';
    if(answered===10)setTimeout(showScore,600);
  }
  function showScore(){
    const card=document.getElementById('scoreCard');
    card.classList.add('show');
    document.getElementById('finalScore').textContent=score;
    let msg='';
    if(score>=9)msg='Luar biasa! Siap menghadapi UKMPPD! 🔥';
    else if(score>=7)msg='Bagus! Sedikit lagi sempurna. Review yang salah ya! 💪';
    else if(score>=5)msg='Lumayan! Masih perlu belajar lebih dalam. 📚';
    else msg='Jangan patah semangat! Baca ulang rangkumannya. Kamu pasti bisa! 🌱';
    document.getElementById('scoreMessage').textContent=msg;
    card.scrollIntoView({behavior:'smooth',block:'center'});
  }
  function resetQuiz(){
    score=0;answered=0;
    document.getElementById('progressText').textContent='0 / 10 dijawab';
    document.getElementById('progressFill').style.width='0%';
    document.getElementById('scoreCard').classList.remove('show');
    for(let i=1;i<=10;i++){
      const card=document.getElementById('q'+i);
      delete card.dataset.answered;
      card.querySelectorAll('.quiz-option').forEach(b=>{b.classList.remove('correct','wrong','disabled');});
      document.getElementById('exp-q'+i).classList.remove('show');
    }
    rebindQuiz();
    window.scrollTo({top:0,behavior:'smooth'});
  }
  function rebindQuiz(){
    const bindings=[
      ['q1',[false,true,false,false,false]],
      ['q2',[false,true,false,false,false]],
      ['q3',[false,true,false,false,false]],
      ['q4',[false,true,false,false,false]],
      ['q5',[false,false,true,false,false]],
      ['q6',[false,false,true,false,false]],
      ['q7',[false,false,true,false,false]],
      ['q8',[false,false,true,false,false]],
      ['q9',[false,false,true,false,false]],
      ['q10',[false,true,false,false,false]],
    ];
    const letters=['A','B','C','D','E'];
    bindings.forEach(([qId,correctArr])=>{
      const card=document.getElementById(qId);
      const btns=card.querySelectorAll('.quiz-option');
      btns.forEach((btn,i)=>{btn.onclick=()=>answer(btn,qId,correctArr[i],letters[i]);});
    });
  }
  window.addEventListener('beforeprint',()=>{document.querySelectorAll('.section').forEach(s=>s.style.display='block');});
  window.addEventListener('afterprint',()=>{document.querySelectorAll('.section').forEach(s=>s.style.display='');document.querySelector('.section.active').style.display='block';});
  rebindQuiz();
</script>
</body>
</html>
