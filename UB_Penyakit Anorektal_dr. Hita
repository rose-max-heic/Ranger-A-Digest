<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Penyakit Anorektal — dr. Hitaputra Agung Wardhana, Sp.B, FINACS</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:         #F0FDF4;
    --forest:     #14532D;
    --green:      #16A34A;
    --green-mid:  #22C55E;
    --green-pale: #DCFCE7;
    --green-soft: #F0FDF4;
    --accent:     #059669;
    --teal:       #0D9488;
    --teal-pale:  #CCFBF1;
    --lime:       #A3E635;
    --lime-pale:  #ECFCCB;
    --text:       #14532D;
    --text-body:  #1C3B2A;
    --muted:      #4B7A5E;
    --border:     #BBF7D0;
    --white:      #FFFFFF;
    --warn:       #D97706;
    --warn-pale:  #FEF3C7;
    --danger:     #DC2626;
    --danger-pale:#FEE2E2;
    --blue:       #2563EB;
    --blue-pale:  #DBEAFE;
    --purple:     #7C3AED;
    --purple-pale:#EDE9FE;
    --sky:        #7DD3FC;
  }

  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    background: var(--bg);
    color: var(--text-body);
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.75;
  }

  /* ===== HERO ===== */
  .hero {
    background: linear-gradient(135deg, var(--forest) 0%, #1a6b3a 45%, #0d7a47 100%);
    color: white;
    padding: 56px 44px 48px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content:''; position:absolute; top:-100px; right:-80px;
    width:380px; height:380px; border-radius:50%;
    background:rgba(163,230,53,0.1);
  }
  .hero::after {
    content:''; position:absolute; bottom:-60px; left:15%;
    width:220px; height:220px; border-radius:50%;
    background:rgba(255,255,255,0.05);
  }
  .hero-tag {
    display:inline-block;
    background:rgba(163,230,53,0.2);
    color:#A3E635;
    font-size:11px; font-weight:600;
    letter-spacing:2px; text-transform:uppercase;
    padding:5px 14px; border-radius:20px; margin-bottom:18px;
    border:1px solid rgba(163,230,53,0.3);
  }
  .hero h1 {
    font-family:'Playfair Display',serif;
    font-size:clamp(26px,5vw,50px);
    font-weight:900; line-height:1.1; margin-bottom:12px;
  }
  .hero h1 span { color: #A3E635; }
  .hero-sub { font-size:14px; opacity:.8; font-weight:300; max-width:620px; }
  .hero-meta { margin-top:26px; display:flex; gap:12px; flex-wrap:wrap; }
  .hero-badge {
    background:rgba(255,255,255,0.12);
    border:1px solid rgba(255,255,255,0.2);
    padding:6px 14px; border-radius:30px;
    font-size:12px; font-weight:500; letter-spacing:.4px;
  }

  /* ===== NAV ===== */
  .sticky-nav {
    position:sticky; top:0; z-index:100;
    background:var(--forest);
    padding:0 28px; display:flex; gap:2px;
    overflow-x:auto; scrollbar-width:none;
    box-shadow:0 3px 18px rgba(20,83,45,0.35);
  }
  .sticky-nav::-webkit-scrollbar { display:none; }
  .nav-btn {
    background:none; border:none;
    color:rgba(255,255,255,0.55);
    font-family:'DM Sans',sans-serif;
    font-size:12px; font-weight:500; letter-spacing:.4px;
    padding:14px 14px; cursor:pointer;
    white-space:nowrap; transition:all .2s;
    border-bottom:2px solid transparent;
  }
  .nav-btn:hover,.nav-btn.active { color:white; border-bottom-color:#A3E635; }

  /* ===== LAYOUT ===== */
  .container { max-width:940px; margin:0 auto; padding:40px 24px; }

  /* ===== SECTIONS ===== */
  .section { display:none; animation:fadeIn .3s ease; }
  .section.active { display:block; }
  @keyframes fadeIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }

  .section-title {
    font-family:'Playfair Display',serif;
    font-size:28px; font-weight:700;
    color:var(--forest); margin-bottom:6px;
  }
  .section-desc {
    color:var(--muted); font-size:13px;
    margin-bottom:30px; padding-bottom:18px;
    border-bottom:2px solid var(--border);
  }

  /* ===== CARDS ===== */
  .card {
    background:white; border-radius:16px;
    padding:24px 28px; margin-bottom:20px;
    border:1px solid var(--border);
    box-shadow:0 2px 12px rgba(20,83,45,0.07);
    transition:box-shadow .2s, transform .2s;
  }
  .card:hover { box-shadow:0 6px 24px rgba(20,83,45,0.12); transform:translateY(-1px); }

  .card-title {
    font-family:'DM Serif Display',serif;
    font-size:18px; color:var(--forest);
    margin-bottom:14px;
    display:flex; align-items:center; gap:10px;
  }
  .card-title .icon {
    width:32px; height:32px; border-radius:8px;
    display:flex; align-items:center; justify-content:center;
    font-size:16px; flex-shrink:0;
  }

  /* ===== TAGS ===== */
  .tag {
    display:inline-block; padding:3px 10px;
    border-radius:12px; font-size:11px; font-weight:600;
    letter-spacing:.5px; margin:2px;
  }
  .tag-green  { background:var(--green-pale); color:var(--forest); }
  .tag-teal   { background:var(--teal-pale);  color:var(--teal); }
  .tag-lime   { background:var(--lime-pale);  color:#3F6212; }
  .tag-warn   { background:var(--warn-pale);  color:#92400E; }
  .tag-danger { background:var(--danger-pale);color:var(--danger); }
  .tag-blue   { background:var(--blue-pale);  color:var(--blue); }
  .tag-purple { background:var(--purple-pale);color:var(--purple); }

  /* ===== TABLES ===== */
  .table-wrap { overflow-x:auto; border-radius:12px; border:1px solid var(--border); margin-bottom:20px; }
  table { width:100%; border-collapse:collapse; font-size:13.5px; }
  th {
    background:var(--forest); color:white;
    padding:11px 14px; text-align:left;
    font-size:12px; font-weight:600; letter-spacing:.4px;
  }
  td { padding:10px 14px; border-bottom:1px solid #DCFCE7; vertical-align:top; }
  tr:last-child td { border-bottom:none; }
  tr:nth-child(even) td { background:#F7FEF9; }
  tr:hover td { background:var(--green-pale); transition:.15s; }

  /* ===== MNEMONIC ===== */
  .mnemonic {
    background:linear-gradient(135deg,#F0FDF4,#DCFCE7);
    border:2px solid #86EFAC;
    border-radius:14px; padding:18px 22px; margin:16px 0;
  }
  .mnemonic-title {
    font-size:12px; font-weight:700;
    letter-spacing:1.5px; text-transform:uppercase;
    color:var(--forest); margin-bottom:10px;
    display:flex; align-items:center; gap:8px;
  }
  .mnemonic-letter {
    display:inline-block; width:26px; height:26px;
    background:var(--green); color:white;
    border-radius:6px; text-align:center;
    line-height:26px; font-size:13px; font-weight:700;
    margin-right:6px; flex-shrink:0;
  }
  .mnemonic-row { display:flex; align-items:baseline; gap:8px; margin:5px 0; font-size:14px; }
  .mnemonic-meaning { color:var(--muted); font-size:13px; }

  /* ===== ALERTS ===== */
  .alert {
    border-radius:12px; padding:14px 18px;
    margin:14px 0; font-size:14px;
    display:flex; gap:12px; align-items:flex-start;
  }
  .alert-icon { font-size:18px; flex-shrink:0; margin-top:1px; }
  .alert-danger { background:var(--danger-pale); border-left:4px solid var(--danger); }
  .alert-warn   { background:var(--warn-pale);   border-left:4px solid var(--warn); }
  .alert-info   { background:var(--blue-pale);   border-left:4px solid var(--blue); }
  .alert-green  { background:var(--green-pale);  border-left:4px solid var(--green); }
  .alert-teal   { background:var(--teal-pale);   border-left:4px solid var(--teal); }

  /* ===== COLLAPSE ===== */
  .collapse-btn {
    width:100%; background:none; border:none;
    display:flex; justify-content:space-between; align-items:center;
    padding:13px 18px; cursor:pointer;
    background:var(--green-soft); border-radius:10px;
    font-family:'DM Sans',sans-serif; font-size:14px; font-weight:600;
    color:var(--forest); margin-bottom:2px; transition:background .2s;
  }
  .collapse-btn:hover { background:var(--green-pale); }
  .collapse-btn::after { content:'▸'; font-size:13px; color:var(--green); transition:transform .25s; }
  .collapse-btn.open::after { transform:rotate(90deg); }
  .collapse-content { display:none; padding:16px 18px 4px; }
  .collapse-content.open { display:block; }

  /* ===== STEP LIST ===== */
  .step-list { list-style:none; }
  .step-list li {
    display:flex; gap:14px; padding:10px 0;
    border-bottom:1px solid var(--green-soft); font-size:14px;
  }
  .step-list li:last-child { border-bottom:none; }
  .step-num {
    min-width:28px; height:28px;
    background:var(--green); color:white;
    border-radius:50%; display:flex; align-items:center;
    justify-content:center; font-size:12px; font-weight:700;
    flex-shrink:0; margin-top:1px;
  }

  /* ===== BULLET LIST ===== */
  .bullet-list { list-style:none; }
  .bullet-list li {
    padding:6px 0; font-size:14px;
    display:flex; gap:10px; align-items:baseline;
  }
  .bullet-list li::before { content:'◆'; color:var(--green-mid); font-size:9px; flex-shrink:0; margin-top:2px; }

  /* ===== GRADE BOX ===== */
  .grade-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin:12px 0; }
  @media(max-width:640px){ .grade-grid{ grid-template-columns:1fr 1fr; } }
  .grade-box {
    border-radius:12px; padding:14px 16px; text-align:center;
    border:1px solid var(--border);
  }
  .grade-num { font-family:'Playfair Display',serif; font-size:28px; font-weight:900; color:var(--green); }
  .grade-label { font-size:11px; font-weight:600; color:var(--muted); margin-top:4px; }
  .grade-desc { font-size:12px; margin-top:6px; color:var(--text-body); }

  /* ===== TWO-COL ===== */
  .two-col { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media(max-width:600px){ .two-col { grid-template-columns:1fr; } }

  /* ===== SKDI BADGE ===== */
  .skdi { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:10px; font-size:11px; font-weight:700; margin-left:6px; }
  .skdi-3b { background:#FEF3C7; color:#92400E; }
  .skdi-3a { background:var(--green-pale); color:var(--forest); }
  .skdi-4a { background:var(--blue-pale); color:var(--blue); }
  .skdi-2  { background:var(--purple-pale); color:var(--purple); }

  /* ===== QUIZ ===== */
  .progress-bar { background:var(--green-pale); border-radius:30px; height:8px; overflow:hidden; margin-bottom:8px; }
  .progress-fill { height:100%; background:linear-gradient(90deg,var(--accent),var(--green-mid)); border-radius:30px; transition:width .4s ease; width:0%; }
  .progress-text { font-size:12px; color:var(--muted); margin-bottom:24px; }

  .quiz-card {
    background:white; border-radius:16px;
    padding:24px 28px; margin-bottom:20px;
    border:1px solid var(--border);
    box-shadow:0 2px 10px rgba(20,83,45,.07);
  }
  .quiz-num { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--green); margin-bottom:10px; }
  .quiz-vignette {
    background:var(--green-soft); border-left:4px solid var(--green);
    border-radius:0 8px 8px 0; padding:14px 16px;
    font-size:14px; margin-bottom:14px; line-height:1.65;
  }
  .quiz-question { font-weight:600; font-size:14.5px; margin-bottom:14px; }
  .quiz-options { display:flex; flex-direction:column; gap:8px; }
  .quiz-option {
    background:white; border:1.5px solid var(--border);
    border-radius:10px; padding:11px 16px;
    text-align:left; cursor:pointer; font-size:13.5px;
    font-family:'DM Sans',sans-serif;
    display:flex; align-items:center; gap:12px;
    transition:all .15s;
  }
  .quiz-option:hover:not(.disabled) { background:var(--green-pale); border-color:var(--green); }
  .quiz-option.correct { background:#D1FAE5; border-color:#34D399; }
  .quiz-option.wrong   { background:var(--danger-pale); border-color:#F87171; }
  .quiz-option.disabled { cursor:default; opacity:.8; }
  .opt-letter {
    min-width:26px; height:26px; background:var(--green-pale);
    color:var(--forest); border-radius:6px;
    display:flex; align-items:center; justify-content:center;
    font-size:12px; font-weight:700; flex-shrink:0;
  }
  .explanation {
    display:none; margin-top:16px;
    background:var(--green-soft); border-radius:10px;
    padding:16px 18px; font-size:13.5px; line-height:1.65;
    border-left:4px solid var(--green);
  }
  .explanation.show { display:block; }
  .quiz-score-card {
    display:none; text-align:center;
    background:linear-gradient(135deg,var(--forest),#1a6b3a);
    border-radius:20px; padding:44px 32px; color:white; margin-top:24px;
  }
  .quiz-score-card.show { display:block; }
  .score-num { font-family:'Playfair Display',serif; font-size:72px; font-weight:900; color:#A3E635; }

  /* ===== FAB ===== */
  .fab {
    position:fixed; bottom:28px; right:28px;
    background:var(--green); color:white; border:none;
    padding:14px 22px; border-radius:50px;
    font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600;
    cursor:pointer; box-shadow:0 6px 20px rgba(22,163,74,.45);
    transition:all .2s; z-index:200;
  }
  .fab:hover { background:var(--forest); transform:translateY(-2px); }

  strong { color:var(--forest); }

  @media print {
    .section { display:block !important; }
    .sticky-nav,.fab { display:none; }
    .card { break-inside:avoid; }
  }

  /* ===== ALUR FLOW ===== */
  .flow-box {
    background:var(--green-pale); border:1px solid #86EFAC;
    border-radius:10px; padding:12px 16px;
    font-size:13.5px; margin:6px 0; text-align:center;
    font-weight:500; color:var(--forest);
  }
  .flow-arrow { text-align:center; font-size:20px; color:var(--green); margin:2px 0; }

  /* ===== COMPARE ===== */
  .compare-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:14px 0; }
  .compare-card { border-radius:12px; padding:16px 18px; border:1px solid var(--border); }
  .compare-card.left  { background:var(--green-pale); border-color:#86EFAC; }
  .compare-card.right { background:var(--teal-pale);  border-color:#5EEAD4; }
  .compare-head { font-weight:700; font-size:13px; margin-bottom:10px; text-transform:uppercase; letter-spacing:.6px; }
  @media(max-width:640px){ .compare-grid{ grid-template-columns:1fr; } }
</style>
</head>
