        <tr><td><strong>Hidradenitis Supurativa</strong></td><td>Purulen dari multipel sinus</td><td>Multipel sinus di kulit perianal, ketiak, selangkangan</td><td>Klinis, kultur</td><td>Antibiotik jangka panjang, wide excision</td></tr>
        <tr><td><strong>Kista Pilonidal</strong></td><td>Discharge dari garis tengah sakrokoksigeus</td><td>Di garis tengah posterior, bukan di perianal; sering pada pria muda berbulu</td><td>MRI</td><td>Eksisi + marsupialisasi / flap</td></tr>
        <tr><td><strong>Proktitis</strong></td><td>Lendir + nanah dari rektum</td><td>Tenesmus, diare, riwayat seks anal atau radioterapi</td><td>Proktoskopi + biopsi + PCR</td><td>Sesuai etiologi</td></tr>
