  body.classList.toggle('open');
}

// ── QUIZ DATA ──
const questions = [
  {
    q: "Pasien datang dengan ikterus, feses dempul, dan urin berwarna teh. Bilirubin direk meningkat signifikan. Apa yang terjadi?",
    opts: ["Hemolisis intravaskular", "Obstruksi saluran empedu (posthepatik)", "Hepatitis akut", "Defisiensi G6PD"],
    ans: 1,
    exp: "Feses dempul = bilirubin direk tidak sampai usus = obstruksi. Bilirubin direk meningkat + bilirubin urin (+) = tanda khas obstruksi posthepatik."
  },
  {
    q: "Enzim manakah yang PALING SPESIFIK untuk kerusakan sel hati (hepatosit)?",
    opts: ["SGOT / AST", "LDH", "SGPT / ALT", "ALP"],
    ans: 2,
    exp: "SGPT/ALT paling spesifik karena terletak terutama di sitoplasma hepar. SGOT/AST juga ada di jantung dan otot skelet; LDH sangat tidak spesifik."
  },
  {
    q: "Seorang pasien hepatitis B kronik menunjukkan HBeAg (+) dan HBV DNA sangat tinggi. Apa makna klinisnya?",
    opts: ["Virus sudah tidak aktif", "Pasien sudah imun", "Virus aktif bereplikasi, sangat infeksius", "Pasien sudah pernah vaksinasi"],
    ans: 2,
    exp: "HBeAg = penanda aktif replikasi virus. HBV DNA tinggi mengkonfirmasi replikasi aktif. Pasien sangat infeksius dan perlu terapi antiviral."
  },
  {
    q: "Pada hepatitis B akut yang sembuh sempurna, pola serologi yang diharapkan setelah 6 bulan adalah:",
    opts: ["HBsAg (+), Anti-HBs (–)", "HBsAg (–), Anti-HBs (+), Anti-HBc IgG (+)", "HBsAg (+), HBeAg (+)", "Semua marker negatif"],
    ans: 1,
    exp: "Setelah recovery: HBsAg hilang, muncul Anti-HBs (antibodi protektif), Anti-HBc IgG menetap seumur hidup sebagai tanda pernah terinfeksi."
  },
  {
    q: "Pasien dengan hepatitis kronik menunjukkan albumin 2,5 g/dL dan PT memanjang. Interpretasi terbaik adalah:",
    opts: ["Defisiensi vitamin K saja", "Fungsi sintesis hepar terganggu berat", "Infeksi akut baru saja", "Hemolisis aktif"],
    ans: 1,
    exp: "Albumin ↓ + PT memanjang = gangguan fungsi sintesis hepar berat. Hepar tidak mampu mensintesis protein dan faktor koagulasi. Ini menandakan penyakit kronik lanjut."
  },
  {
    q: "GGT meningkat 3× dan ALP meningkat 6× pada pasien tanpa kelainan tulang atau kehamilan. Kemungkinan diagnosis adalah:",
    opts: ["Hepatitis akut viral", "Obstruksi saluran empedu / kolestasis", "Anemia hemolitik", "Insufisiensi pankreas"],
    ans: 1,
    exp: "ALP dan GGT meningkat signifikan (ALP >3×) = pola kolestatik = obstruksi saluran empedu atau kolestasis intrahepatik. Bukan pola hepatoselular."
  },
  {
    q: "Total anti-HAV positif tetapi IgM anti-HAV negatif. Interpretasi yang tepat adalah:",
    opts: ["Infeksi hepatitis A akut saat ini", "Pernah terinfeksi / punya imunitas (IgG)", "Belum pernah terpapar", "Pasca vaksinasi hepatitis B"],
    ans: 1,
    exp: "Total anti-HAV (+) dengan IgM anti-HAV (–) = komponen yang tersisa adalah IgG anti-HAV = pernah terinfeksi atau sudah imun. BUKAN infeksi aktif saat ini."
  },
  {
    q: "AFP ≥ 400 ng/mL pada pasien sirosis hepatitis B. Apa langkah selanjutnya?",
    opts: ["Ulangi tes setelah 1 tahun", "Segera evaluasi untuk karsinoma hepatoselular (HCC)", "Pertimbangkan transfusi albumin", "Mulai terapi antiviral pertama kali"],
    ans: 1,
    exp: "AFP ≥ 400 ng/mL = kuat curiga karsinoma hepatoselular (HCC). Perlu konfirmasi segera dengan imaging (USG/CT triphasic/MRI). Pada sirosis, skrining AFP berkala sangat penting."
  },
  {
    q: "Pemeriksaan feses menunjukkan feses berwarna hitam (melena). Lokasi perdarahan yang paling mungkin adalah:",
    opts: ["Rektum dan anus", "Kolon sigmoid", "Lambung atau duodenum (GI atas)", "Kolon transversum"],
    ans: 2,
    exp: "Melena (hitam) = darah teroksidasi oleh asam lambung → perdarahan GI atas (lambung, duodenum, esofagus). Darah merah segar = GI bawah (tidak melewati asam lambung)."
  },
  {
    q: "Virus hepatitis mana yang HANYA bisa menginfeksi individu yang sudah terinfeksi HBV?",
    opts: ["Hepatitis A", "Hepatitis C", "Hepatitis D", "Hepatitis E"],
    ans: 2,
    exp: "Hepatitis D adalah 'defective virus' yang membutuhkan HBsAg dari HBV sebagai selubungnya. HDV hanya bisa menginfeksi koinfeksi atau superinfeksi bersama HBV."
  }
];

let selected = new Array(questions.length).fill(null);
let checked = new Array(questions.length).fill(false);

function renderQuiz() {
  const container = document.getElementById('quizContainer');
  container.innerHTML = questions.map((q, i) => `
    <div class="quiz-card" id="qcard-${i}">
      <div class="quiz-num">Soal ${i+1} dari ${questions.length}</div>
      <div class="quiz-q">${q.q}</div>
      <div class="quiz-options" id="opts-${i}">
        ${q.opts.map((opt, j) => `
          <div class="quiz-opt" onclick="selectOpt(${i}, ${j})" id="opt-${i}-${j}">
            <div class="quiz-opt-letter">${'ABCD'[j]}</div>
            <span>${opt}</span>
          </div>
        `).join('')}
      </div>
      <div class="quiz-feedback" id="feedback-${i}"></div>
      <div class="quiz-actions">
        <button class="btn-check" onclick="checkAnswer(${i})" id="btn-${i}" disabled>Periksa Jawaban</button>
      </div>
    </div>
  `).join('');
  updateProgress();
}

function selectOpt(qi, oi) {
  if (checked[qi]) return;
  selected[qi] = oi;
  document.querySelectorAll(`#opts-${qi} .quiz-opt`).forEach((el, j) => {
    el.classList.toggle('selected', j === oi);
  });
  document.getElementById(`btn-${qi}`).disabled = false;
}

function checkAnswer(qi) {
  if (checked[qi]) return;
  checked[qi] = true;
  const q = questions[qi];
  const fb = document.getElementById(`feedback-${qi}`);
  document.getElementById(`btn-${qi}`).disabled = true;

  document.querySelectorAll(`#opts-${qi} .quiz-opt`).forEach((el, j) => {
    el.onclick = null;
    if (j === q.ans) el.classList.add('correct');
    else if (j === selected[qi] && selected[qi] !== q.ans) el.classList.add('wrong');
  });

  const correct = selected[qi] === q.ans;
  fb.className = `quiz-feedback show ${correct ? 'correct-fb' : 'wrong-fb'}`;
  fb.innerHTML = `<strong>${correct ? '✅ Benar!' : '❌ Salah.'}</strong> ${q.exp}`;

  updateProgress();
  checkAllDone();
}

function updateProgress() {
  const done = checked.filter(Boolean).length;
  document.getElementById('quizProgress').style.width = (done / questions.length * 100) + '%';
}

function checkAllDone() {
  if (!checked.every(Boolean)) return;
  const score = questions.reduce((acc, q, i) => acc + (selected[i] === q.ans ? 1 : 0), 0);
  const box = document.getElementById('scoreBox');
  document.getElementById('scoreNum').textContent = `${score}/${questions.length}`;
  const pct = Math.round(score/questions.length*100);
  let msg = pct >= 90 ? '🏆 Luar biasa! Kamu siap ujian.' :
            pct >= 70 ? '👍 Bagus! Ulangi materi yang salah.' :
            pct >= 50 ? '📚 Perlu belajar lebih giat. Review materi dan coba lagi.' :
                        '💪 Jangan menyerah! Baca kembali materi dari awal.';
  document.getElementById('scoreMsg').textContent = msg;
  box.classList.add('show');
  box.scrollIntoView({behavior:'smooth', block:'start'});
}

function resetQuiz() {
  selected = new Array(questions.length).fill(null);
  checked = new Array(questions.length).fill(false);
  document.getElementById('scoreBox').classList.remove('show');
  renderQuiz();
  document.getElementById('quizContainer').scrollIntoView({behavior:'smooth'});
}

renderQuiz();
</script>
