<section class="section" id="quiz-section">
  <div class="section-header">
    <span class="section-num">09</span>
    <h2 class="section-title">Quiz Interaktif</h2>
  </div>

  <div class="quiz-header">
    <div class="quiz-header-icon">✏️</div>
    <div>
      <h3>Uji Pemahaman</h3>
      <p>12 soal pilihan ganda — pemeriksaan mikrobiologi traktus digestivus</p>
    </div>
  </div>

  <div class="quiz-progress-bar"><div class="quiz-progress-fill" id="progressFill"></div></div>
  <div class="quiz-progress-text" id="progressText">Soal 0 dari 12</div>

  <!-- Q1 -->
  <div class="quiz-question-card active" data-q="0">
    <div class="quiz-q-num">SOAL 01 / 12</div>
    <div class="quiz-q-text">Seorang pasien datang dengan diare akut 3 hari. Untuk menegakkan etiologi pasti infeksi bakteri, pemeriksaan gold standard yang sebaiknya dilakukan adalah...</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Pewarnaan Gram feses</div>
      <div class="quiz-option" data-correct="false">Darah rutin (hitung leukosit)</div>
      <div class="quiz-option" data-correct="true">Kultur feses</div>
      <div class="quiz-option" data-correct="false">Foto polos abdomen</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Kultur adalah gold standard untuk infeksi karena bisa mengidentifikasi jenis kuman secara spesifik, bukan hanya ada/tidaknya infeksi.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> Kultur feses adalah gold standard karena mengidentifikasi patogen secara spesifik — jenis bakteri menentukan terapi yang tepat.</div>
  </div>

  <!-- Q2 -->
  <div class="quiz-question-card" data-q="1">
    <div class="quiz-q-num">SOAL 02 / 12</div>
    <div class="quiz-q-text">Pemeriksaan KOH pada kerokan lesi oral menunjukkan struktur memanjang bercabang dan bentuk oval di ujungnya. Gambaran ini disebut...</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Hifa sejati dan konidia</div>
      <div class="quiz-option" data-correct="true">Pseudohifa dan blastospora</div>
      <div class="quiz-option" data-correct="false">Miselium dan spora</div>
      <div class="quiz-option" data-correct="false">Hifa dan askospora</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Pseudohifa (struktur memanjang) + blastospora (oval/bulat) adalah gambaran khas Candida albicans pada pemeriksaan KOH.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> Candida albicans memiliki dua struktur utama: pseudohifa (memanjang seperti ranting) dan blastospora (oval, tunas sel jamur).</div>
  </div>

  <!-- Q3 -->
  <div class="quiz-question-card" data-q="2">
    <div class="quiz-q-num">SOAL 03 / 12</div>
    <div class="quiz-q-text">Helicobacter pylori dapat bertahan di lambung yang asam karena memiliki enzim yang mengubah urea menjadi amonia dan CO₂. Enzim tersebut adalah...</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Protease</div>
      <div class="quiz-option" data-correct="false">Lipase</div>
      <div class="quiz-option" data-correct="true">Urease</div>
      <div class="quiz-option" data-correct="false">Katalase</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Urease adalah enzim khas H. pylori. Amonia yang dihasilkan menetralkan asam lambung di sekitar bakteri, memungkinkan ia bertahan hidup.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> Enzim yang tepat adalah urease — mengubah urea → amonia + CO₂. Amonia bersifat basa, menetralkan keasaman lokal.</div>
  </div>

  <!-- Q4 -->
  <div class="quiz-question-card" data-q="3">
    <div class="quiz-q-num">SOAL 04 / 12</div>
    <div class="quiz-q-text">Pada media EMB (Eosin Methylene Blue), E. coli menunjukkan gambaran koloni yang khas berupa...</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Koloni pink/merah muda</div>
      <div class="quiz-option" data-correct="true">Koloni hijau mengkilat (metallic sheen)</div>
      <div class="quiz-option" data-correct="false">Koloni hitam dengan pusat gelap</div>
      <div class="quiz-option" data-correct="false">Koloni tidak berwarna (colorless)</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Metallic sheen (hijau mengkilat) adalah gambaran khas E. coli pada media EMB karena fermentasi laktosa yang kuat menghasilkan asam → eosin mengendap pada koloni.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> E. coli pada EMB menunjukkan koloni hijau mengkilat (metallic sheen) — ciri khas akibat fermentasi laktosa yang kuat.</div>
  </div>

  <!-- Q5 -->
  <div class="quiz-question-card" data-q="4">
    <div class="quiz-q-num">SOAL 05 / 12</div>
    <div class="quiz-q-text">Pada media SS Agar, ditemukan koloni yang tidak berwarna dengan endapan hitam di tengahnya. Organisme manakah yang paling mungkin?</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">E. coli</div>
      <div class="quiz-option" data-correct="false">Shigella dysenteriae</div>
      <div class="quiz-option" data-correct="true">Salmonella typhi</div>
      <div class="quiz-option" data-correct="false">Candida albicans</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Endapan hitam menunjukkan produksi H₂S. Salmonella menghasilkan H₂S, sedangkan Shigella tidak. Keduanya tidak memfermentasi laktosa (sehingga tidak merah).</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> Endapan hitam = H₂S. Hanya Salmonella yang menghasilkan H₂S di antara keduanya. Shigella tidak memfermentasi laktosa tapi tidak ada H₂S.</div>
  </div>

  <!-- Q6 -->
  <div class="quiz-question-card" data-q="5">
    <div class="quiz-q-num">SOAL 06 / 12</div>
    <div class="quiz-q-text">Mengapa pemeriksaan pewarnaan feses tidak efektif untuk mendeteksi virus sebagai penyebab diare?</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Virus terlalu cepat bergerak</div>
      <div class="quiz-option" data-correct="true">Virus berukuran submikroskopis dan tidak dapat divisualisasi dengan pewarnaan biasa</div>
      <div class="quiz-option" data-correct="false">Virus tidak ada di feses</div>
      <div class="quiz-option" data-correct="false">Pewarnaan merusak virus</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Virus berukuran sub-seluler, jauh lebih kecil dari bakteri maupun jamur. Tidak dapat divisualisasi dengan mikroskop cahaya + pewarnaan biasa.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> Alasannya karena ukuran virus yang submikroskopis — tidak bisa terlihat dengan mikroskop cahaya dan pewarnaan konvensional, berapapun lamanya diperiksa.</div>
  </div>

  <!-- Q7 -->
  <div class="quiz-question-card" data-q="6">
    <div class="quiz-q-num">SOAL 07 / 12</div>
    <div class="quiz-q-text">Media Skirrow untuk H. pylori mengandung vankomisin, polimiksin, dan trimetoprim. Fungsi ketiga antibiotik ini secara berturutan adalah...</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="true">Menghambat Gram positif, Gram negatif lain, bakteri kontaminan lain</div>
      <div class="quiz-option" data-correct="false">Membunuh Gram negatif, Gram positif, jamur</div>
      <div class="quiz-option" data-correct="false">Menghambat anaerob, aerob, virus</div>
      <div class="quiz-option" data-correct="false">Stimulasi H. pylori, menghambat Gram positif, menghambat jamur</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Vankomisin → Gram positif; Polimiksin → Gram negatif lain; Trimetoprim → kontaminan lain. Kombinasi ini membuat hanya H. pylori yang bisa tumbuh.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> Vankomisin menghambat Gram positif, Polimiksin menghambat Gram negatif lain, Trimetoprim menghambat kontaminan lainnya — sehingga hanya H. pylori yang dapat tumbuh.</div>
  </div>

  <!-- Q8 -->
  <div class="quiz-question-card" data-q="7">
    <div class="quiz-q-num">SOAL 08 / 12</div>
    <div class="quiz-q-text">E. coli disebut flora normal di traktus digestivus karena salah satu alasannya ia membantu produksi vitamin apa?</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Vitamin C</div>
      <div class="quiz-option" data-correct="false">Vitamin D</div>
      <div class="quiz-option" data-correct="true">Vitamin K</div>
      <div class="quiz-option" data-correct="false">Vitamin B12</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> E. coli membantu produksi Vitamin K di kolon. Ini menjadi salah satu alasan sistem imun "membiarkan" E. coli hidup di traktus digestivus sebagai flora normal.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> E. coli membantu produksi Vitamin K — karena bermanfaat bagi hospes, sistem imun tidak mendestruksinya, menjadikannya flora normal.</div>
  </div>

  <!-- Q9 -->
  <div class="quiz-question-card" data-q="8">
    <div class="quiz-q-num">SOAL 09 / 12</div>
    <div class="quiz-q-text">Pada media HEA (Hektoen Enteric Agar), warna dasar media adalah hijau. Jika ditemukan koloni berwarna merah di atas media ini, organisme yang paling mungkin adalah...</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Salmonella</div>
      <div class="quiz-option" data-correct="false">Shigella</div>
      <div class="quiz-option" data-correct="true">E. coli atau bakteri fermenter laktosa lainnya</div>
      <div class="quiz-option" data-correct="false">Candida albicans</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Pada HEA, warna dasar hijau. Bakteri fermenter (seperti E. coli) mengubah warna menjadi merah/salmon. Salmonella → hijau + hitam, Shigella → hijau tanpa hitam.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> Di HEA: hijau = non-fermenter (Shigella), hijau + hitam = Salmonella, merah = fermenter seperti E. coli.</div>
  </div>

  <!-- Q10 -->
  <div class="quiz-question-card" data-q="9">
    <div class="quiz-q-num">SOAL 10 / 12</div>
    <div class="quiz-q-text">Seorang pasien HIV datang dengan sariawan yang tidak kunjung sembuh. Pemeriksaan KOH menunjukkan pseudohifa dan blastospora. Apa yang sebaiknya diberikan?</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Antibiotik spektrum luas</div>
      <div class="quiz-option" data-correct="false">Antivirus</div>
      <div class="quiz-option" data-correct="true">Antifungal (misalnya flukonazol)</div>
      <div class="quiz-option" data-correct="false">Antiparasit</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Pseudohifa + blastospora = Candida albicans = Kandidiasis oral. Terapi adalah antifungal. Pada pasien HIV, kandidiasis oral sering menjadi tanda awal imunodefisiensi.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> Hasil KOH menunjukkan Candida albicans (jamur). Terapinya adalah antifungal, bukan antibiotik atau antivirus.</div>
  </div>

  <!-- Q11 -->
  <div class="quiz-question-card" data-q="10">
    <div class="quiz-q-num">SOAL 11 / 12</div>
    <div class="quiz-q-text">Mengapa kultur H. pylori lebih lama dari kultur bakteri biasa, minimal 3–7 hari?</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Karena H. pylori berkembang sangat cepat</div>
      <div class="quiz-option" data-correct="true">Karena H. pylori bersifat fastidious — butuh kondisi khusus (mikroaerofilik, CO₂ tinggi) yang memperlambat pertumbuhannya</div>
      <div class="quiz-option" data-correct="false">Karena media Skirrow harus dipersiapkan lama</div>
      <div class="quiz-option" data-correct="false">Karena H. pylori harus melewati 3 siklus hidup terlebih dahulu</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> H. pylori bersifat fastidious — sangat "rewel" — butuh kondisi mikroaerofilik (O₂ rendah), CO₂ tinggi, suhu 37°C, dan media yang diperkaya. Kondisi inilah yang membuatnya tumbuh lambat.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> H. pylori fastidious = membutuhkan kondisi sangat spesifik (mikroaerofilik, CO₂ tinggi, media diperkaya). Kondisi ini menyebabkan pertumbuhan lebih lambat.</div>
  </div>

  <!-- Q12 -->
  <div class="quiz-question-card" data-q="11">
    <div class="quiz-q-num">SOAL 12 / 12</div>
    <div class="quiz-q-text">Pada media MacConkey Agar, E. coli menunjukkan koloni berwarna pink, sementara Shigella menunjukkan koloni tidak berwarna. Perbedaan ini didasarkan pada kemampuan...</div>
    <div class="quiz-options">
      <div class="quiz-option" data-correct="false">Produksi H₂S</div>
      <div class="quiz-option" data-correct="false">Pembentukan kapsul</div>
      <div class="quiz-option" data-correct="true">Fermentasi laktosa — E. coli positif, Shigella negatif</div>
      <div class="quiz-option" data-correct="false">Kemampuan bergerak (motilitas)</div>
    </div>
    <div class="quiz-feedback correct">✅ <strong>Benar!</strong> Media MacConkey mengandung laktosa + neutral red. Fermenter laktosa (E. coli) → produksi asam → pH turun → warna pink. Non-fermenter (Shigella) → tidak ada perubahan warna.</div>
    <div class="quiz-feedback wrong">❌ <strong>Kurang tepat.</strong> Perbedaan warna di MacConkey berdasarkan fermentasi laktosa. E. coli (fermenter kuat) = pink. Shigella (non-fermenter) = tidak berwarna.</div>
  </div>

  <div class="quiz-nav" id="quizNav">
    <button class="btn" id="nextBtn" onclick="handleQuizNext()">Mulai Quiz →</button>
  </div>

  <!-- Result -->
  <div class="quiz-result" id="quizResult">
    <div class="result-score" id="resultScore">0/12</div>
    <div class="result-label">Skor Akhir</div>
    <div class="result-msg" id="resultMsg">—</div>
    <div class="result-sub" id="resultSub">—</div>
    <div class="result-breakdown">
      <div class="rb-item">
        <div class="rb-num" id="rbCorrect" style="color: var(--green);">0</div>
        <div class="rb-label">Benar</div>
      </div>
      <div class="rb-item">
        <div class="rb-num" id="rbWrong" style="color: var(--red);">0</div>
        <div class="rb-label">Salah</div>
      </div>
      <div class="rb-item">
        <div class="rb-num" id="rbPct" style="color: var(--gold);">0%</div>
        <div class="rb-label">Persentase</div>
      </div>
    </div>
    <button class="btn" onclick="restartQuiz()">Ulangi Quiz 🔄</button>
  </div>
</section>

</main>

<button class="back-to-top" id="backTop" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>

<script>
  // ── BACK TO TOP ──
  const backTop = document.getElementById('backTop');
  window.addEventListener('scroll', () => {
    backTop.classList.toggle('visible', window.scrollY > 400);
  });

  // ── NAV ACTIVE ──
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.toc a');
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        navLinks.forEach(l => l.classList.remove('active'));
        const active = document.querySelector(`.toc a[href="#${e.target.id}"]`);
        if (active) active.classList.add('active');
      }
    });
  }, { threshold: 0.3 });
  sections.forEach(s => obs.observe(s));

  // ── QUIZ ──
  let currentQ = -1;
  let answered = false;
  let score = 0;
  let wrong = 0;
  const totalQ = 12;
  const questions = document.querySelectorAll('.quiz-question-card');

  function updateProgress() {
    const pct = currentQ < 0 ? 0 : ((currentQ + 1) / totalQ * 100);
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('progressText').textContent =
      currentQ < 0 ? `Soal 0 dari ${totalQ}` : `Soal ${currentQ + 1} dari ${totalQ}`;
  }

  function handleQuizNext() {
    const btn = document.getElementById('nextBtn');
    if (currentQ === -1) {
      // Start
      currentQ = 0;
      questions[0].classList.add('active');
      btn.textContent = 'Soal Berikutnya →';
      updateProgress();
      return;
    }
    if (!answered) return;
    // Move to next
    questions[currentQ].classList.remove('active');
    currentQ++;
    if (currentQ >= totalQ) {
      showResult();
      return;
    }
    questions[currentQ].classList.add('active');
    answered = false;
    btn.textContent = currentQ === totalQ - 1 ? 'Lihat Hasil →' : 'Soal Berikutnya →';
    updateProgress();
  }

  // Attach option click handlers
  document.querySelectorAll('.quiz-option').forEach(opt => {
    opt.addEventListener('click', function() {
      if (answered) return;
      const card = this.closest('.quiz-question-card');
      const allOpts = card.querySelectorAll('.quiz-option');
      const isCorrect = this.dataset.correct === 'true';
      allOpts.forEach(o => {
        o.classList.add('disabled');
        if (o.dataset.correct === 'true') o.classList.add('reveal-correct');
      });
      if (isCorrect) {
        this.classList.add('selected-correct');
        score++;
        card.querySelector('.quiz-feedback.correct').style.display = 'block';
      } else {
        this.classList.add('selected-wrong');
        wrong++;
        card.querySelector('.quiz-feedback.wrong').style.display = 'block';
      }
      answered = true;
      const btn = document.getElementById('nextBtn');
      btn.style.display = 'flex';
    });
  });

  function showResult() {
    document.getElementById('quizNav').style.display = 'none';
    const result = document.getElementById('quizResult');
    result.classList.add('show');
    const pct = Math.round(score / totalQ * 100);
    document.getElementById('resultScore').textContent = `${score}/${totalQ}`;
    document.getElementById('rbCorrect').textContent = score;
    document.getElementById('rbWrong').textContent = wrong;
    document.getElementById('rbPct').textContent = pct + '%';

    let msg, sub;
    if (pct >= 90) { msg = '🏆 Luar Biasa!'; sub = 'Penguasaan materi sangat baik. Siap hadapi ujian!'; }
    else if (pct >= 70) { msg = '👍 Bagus!'; sub = 'Pemahaman sudah cukup solid. Review bagian yang salah ya.'; }
    else if (pct >= 50) { msg = '📚 Perlu Belajar Lebih'; sub = 'Ada beberapa konsep yang perlu diperkuat. Baca ulang materi dan coba lagi!'; }
    else { msg = '💪 Jangan Menyerah!'; sub = 'Mulai dari awal, baca materi dengan teliti, dan coba kembali. Kamu bisa!'; }

    document.getElementById('resultMsg').textContent = msg;
    document.getElementById('resultSub').textContent = sub;
    result.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function restartQuiz() {
    currentQ = -1;
    score = 0;
    wrong = 0;
    answered = false;

    questions.forEach(q => {
      q.classList.remove('active');
      q.querySelectorAll('.quiz-option').forEach(o => {
        o.classList.remove('selected-correct', 'selected-wrong', 'reveal-correct', 'disabled');
      });
      q.querySelectorAll('.quiz-feedback').forEach(f => f.style.display = 'none');
    });

    document.getElementById('quizResult').classList.remove('show');
    document.getElementById('quizNav').style.display = 'flex';
    document.getElementById('nextBtn').textContent = 'Mulai Quiz →';
    updateProgress();
    document.getElementById('quiz-section').scrollIntoView({ behavior: 'smooth' });
  }

  updateProgress();
</script>
</body>
</html>
