    if (answered[qId]) return;
    answered[qId] = true;

    const allBtns = btn.closest('.options').querySelectorAll('.option-btn');
    allBtns.forEach(b => {
      b.disabled = true;
      const letter = b.querySelector('.option-letter').textContent;
      if (b === btn) {
        b.classList.add(result === 'correct' ? 'correct' : 'wrong');
      }
    });

    // If wrong, reveal correct answer
    if (result === 'wrong') {
      const correctBtns = btn.closest('.options').querySelectorAll('.option-btn');
      const exp = document.getElementById('exp-' + qId);
      const correctMatch = exp.textContent.match(/Jawaban: ([A-E])/);
      if (correctMatch) {
        const correctLetter = correctMatch[1];
        correctBtns.forEach(b => {
          if (b.querySelector('.option-letter').textContent === correctLetter) {
            b.classList.add('reveal-correct');
          }
        });
      }
    }

    scores[qId] = result === 'correct' ? 1 : 0;
    document.getElementById('exp-' + qId).classList.add('show');
    updateScore();
  }

  function updateScore() {
    const total = Object.keys(scores).length;
    const correct = Object.values(scores).reduce((a, b) => a + b, 0);
    document.getElementById('scoreDisplay').textContent = correct + ' / ' + total;
    
    const pct = total > 0 ? correct / total : 0;
    let emoji = '🌸';
    if (total >= 5) {
      if (pct >= 0.8) emoji = '🌟';
      else if (pct >= 0.6) emoji = '💛';
      else if (pct >= 0.4) emoji = '🌸';
      else emoji = '📚';
    }
    document.getElementById('scoreEmoji').textContent = emoji;
  }

  function resetQuiz() {
    scores = {};
    answered = {};
    document.querySelectorAll('.option-btn').forEach(b => {
      b.classList.remove('correct', 'wrong', 'reveal-correct');
      b.disabled = false;
    });
    document.querySelectorAll('.explanation').forEach(e => e.classList.remove('show'));
    document.getElementById('scoreDisplay').textContent = '0 / 0';
    document.getElementById('scoreEmoji').textContent = '🌸';
  }

  // Sticky nav active state on scroll
  const sections = ['intro','clp','mikro','ea','vacterl','quiz'];
  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(id => {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top < 120) current = id;
    });
    document.querySelectorAll('.nav-btn').forEach((btn, i) => {
      btn.classList.toggle('active', i < sections.length && sections[i] === current);
    });
  });
</script>
</body>
</html>
