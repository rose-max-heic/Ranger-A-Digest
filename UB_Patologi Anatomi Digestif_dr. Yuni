    q:"Seorang bayi baru lahir memiliki usus yang keluar dari dinding abdomen tanpa lapisan peritoneum. Kondisi ini dan penanganan pertama yang BENAR?",
    opts:["Omphalocele — segera tutup dengan balutan steril","Gastroschisis — basahi dengan NaCl fisiologis, jangan dibiarkan kering","Divertikulum Meckel — observasi, operasi elektif","Hirschsprung — enema kolon"],
    ans:1,
    exp:"Gastroschisis: defek dinding abdomen TANPA peritoneum (berbeda dengan omphalocele yang masih ada peritoneum). Usus terpapar langsung → risiko nekrosis dan infeksi sangat tinggi. Penanganan PERTAMA: tutup dengan kassa NaCl basah (jangan kering!) segera, lalu operasi emergensi."
  },
  {
    q:"Urutan patogenesis yang BENAR dari GERD kronik hingga berkembangnya adenokarsinoma esofagus adalah?",
    opts:[
      "Esofagitis → Barrett esofagus → Displasia LG → Displasia HG → Adenokarsinoma",
      "Akalasia → Stasis bolus → Ulkus → SCC",
      "Gastritis → Metaplasia intestinal → Displasia → Adenokarsinoma gaster",
      "Varises → Ruptur → Perdarahan → Fibrosis → Karsinoma"
    ],
    ans:0,
    exp:"Urutan Barrett → Adenokarsinoma: GERD kronik → Esofagitis (radang epitel skuamosa) → Barrett Esofagus (metaplasia kolumnar intestinal) → Displasia Low Grade → Displasia High Grade → Adenokarsinoma. Panjang? Iya, tapi inilah alasan pentingnya surveillance Barrett dengan endoskopi berkala."
  }
];

let curQ=0, score=0, answered=[];

function renderQ(idx){
  const q=Qs[idx];
  const letters=['A','B','C','D'];
  document.getElementById('qcontainer').innerHTML=`
    <div class="qcard">
      <div class="qnum">Soal ${idx+1} dari ${Qs.length}</div>
      <div class="qtext">${q.q}</div>
      <div class="qopts" id="opts${idx}">
        ${q.opts.map((o,i)=>`
          <button class="qbtn" onclick="pickAns(${idx},${i})" id="opt${idx}${i}">
            <span class="qletter">${letters[i]}</span>${o}
          </button>`).join('')}
      </div>
      <div class="qexp" id="exp${idx}">💡 <strong>Penjelasan:</strong> ${q.exp}</div>
    </div>
    <div class="qctrl">
      <button class="btn btnp" id="nxtbtn" onclick="nextQ()" style="display:none;">
        ${idx<Qs.length-1?'Soal Berikutnya →':'Lihat Hasil 🎉'}
      </button>
    </div>`;
  updateProg(idx);
}

function pickAns(qIdx,optIdx){
  if(answered[qIdx]!==undefined)return;
  answered[qIdx]=optIdx;
  const q=Qs[qIdx];
  document.querySelectorAll(`#opts${qIdx} .qbtn`).forEach((btn,i)=>{
    btn.onclick=null;
    if(i===q.ans)btn.classList.add('correct');
    else if(i===optIdx&&optIdx!==q.ans)btn.classList.add('wrong');
    else btn.style.opacity='.45';
  });
  if(optIdx===q.ans)score++;
  document.getElementById(`exp${qIdx}`).classList.add('show');
  document.getElementById('nxtbtn').style.display='inline-flex';
  document.getElementById('qscoretext').textContent=`Skor: ${score}`;
}

function nextQ(){
  curQ++;
  if(curQ<Qs.length)renderQ(curQ);
  else showResult();
}

function updateProg(idx){
  const p=((idx+1)/Qs.length)*100;
  document.getElementById('qfill').style.width=p+'%';
  document.getElementById('qprogtext').textContent=`Soal ${idx+1} / ${Qs.length}`;
}

function showResult(){
  document.getElementById('qcontainer').style.display='none';
  document.querySelector('.qprog').style.display='none';
  const pct=Math.round((score/Qs.length)*100);
  const r=document.getElementById('qresult');r.classList.add('show');
  document.getElementById('qfinalscore').textContent=`${score}/${Qs.length}`;
  let lab,msg;
  if(pct>=90){lab='🏆 Luar Biasa!';msg='Penguasaan materi patologi digestif sangat baik!';}
  else if(pct>=75){lab='✅ Bagus!';msg='Pemahaman solid. Tinjau kembali topik yang masih salah.';}
  else if(pct>=50){lab='📚 Perlu Review';msg='Pelajari ulang urutan patogenesis dan ciri khas masing-masing penyakit.';}
  else{lab='💪 Terus Semangat!';msg='Baca ulang materi mulai dari konsep dasar (inflamasi→degenerasi→neoplasma).';}
  document.getElementById('qresultlabel').textContent=lab;
  document.getElementById('qresultmsg').textContent=msg;
}

function restartQuiz(){
  curQ=0;score=0;answered=[];
  document.getElementById('qcontainer').style.display='block';
  document.querySelector('.qprog').style.display='flex';
  document.getElementById('qresult').classList.remove('show');
  document.getElementById('qscoretext').textContent='Skor: 0';
  renderQ(0);
}

renderQ(0);
</script>
