<!-- 4. USUS HALUS -->
<!-- ═══════════════════════════════ -->
<section id="usus">
  <div class="sec-head">
    <div class="sec-num">04</div>
    <div class="sec-info">
      <h2>Patologi Usus Halus</h2>
      <p>Kongenital · Divertikel Meckel · Omphalocele & Gastroschisis · Obstruksi</p>
    </div>
  </div>

  <div class="grid2">
    <div class="card ct">
      <h3>🧬 Kongenital — Atresia & Stenosis</h3>
      <ul>
        <li><strong>Atresia:</strong> kegagalan perkembangan usus — atresia duodeni paling sering</li>
        <li><strong>Stenosis:</strong> penyempitan lumen → hipertrofi sfingter / kelainan persarafan / tebalnya dinding</li>
        <li>Manifestasi neonatus: muntah bilious, distensi abdomen</li>
        <li>Penanganan: koreksi bedah</li>
      </ul>
    </div>
    <div class="card ca">
      <h3>🎪 Divertikulum Meckel</h3>
      <ul>
        <li>Kegagalan involusi duktus omfalomesenterik saat dalam kandungan</li>
        <li>Penonjolan buntu ileum ±80 cm dari katup ileocaecal</li>
        <li>Panjang 5–6 cm, <strong>dinding = dinding usus normal</strong></li>
        <li>Umumnya asimptomatik; jika bergejala: perdarahan, invaginasi, divertikulitis</li>
        <li>Bedakan dengan divertikulosis kolon (acquired, tidak ada muskularis propria)</li>
      </ul>
    </div>
  </div>

  <div class="grid2" style="margin-top:4px;">
    <div class="card cc">
      <h3>🔴 Omphalocele vs Gastroschisis</h3>
      <div class="tw" style="margin-top:8px;">
        <table>
          <thead><tr><th></th><th>Omphalocele</th><th>Gastroschisis</th></tr></thead>
          <tbody>
            <tr><td><strong>Peritoneum</strong></td><td>Ada (menutup)</td><td>Tidak ada (terbuka!)</td></tr>
            <tr><td><strong>Risiko infeksi</strong></td><td>Lebih rendah</td><td>Sangat tinggi</td></tr>
            <tr><td><strong>Risiko nekrosis</strong></td><td>Lebih rendah</td><td>Tinggi (usus terpapar)</td></tr>
            <tr><td><strong>Urgensi bedah</strong></td><td>Segera</td><td>Emergensi!</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size:13px;color:var(--mid);margin-top:8px;">Gastroschisis: tutup dengan NaCl basah segera, hindari kekeringan → nekrosis cepat</p>
    </div>
    <div class="card cs">
      <h3>🔀 Obstruksi Usus</h3>
      <ul>
        <li><strong>Mekanik:</strong> hernia, adhesi, intususepsi, <strong>volvulus</strong> (torsi usus)</li>
        <li><strong>Volvulus</strong> → terpuntir → iskemia → nekrosis → peritonitis</li>
        <li><strong>Fungsional (ileus paralitik):</strong> pasca bedah, infeksi intraabdomen</li>
        <li>Manifestasi: nyeri kolik, distensi, tidak flatus, muntah</li>
        <li>X-ray: air-fluid levels, dilated loops</li>
      </ul>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════ -->
<!-- 5. KOLON -->
<!-- ═══════════════════════════════ -->
<section id="kolon">
  <div class="sec-head">
    <div class="sec-num">05</div>
    <div class="sec-info">
      <h2>Patologi Kolon & Rektum</h2>
      <p>Hirschsprung · Divertikulosis · Polip · Karsinoma Kolorektal</p>
    </div>
  </div>

  <!-- Hirschsprung -->
  <div class="card cr">
    <h3>🧬 A. Hirschsprung Disease (Congenital Megacolon)</h3>
    <div class="chain" style="margin-top:12px;">
      <div class="ch-step">
        <div class="ch-left"><div class="ch-dot" style="background:var(--teal);">1</div><div class="ch-line"></div></div>
        <div class="ch-body"><h4>Aganglionosis Kongenital</h4><p>Berhentinya migrasi sel krista neuralis sebelum mencapai anus → segmen kolon tanpa ganglion (Meissner &amp; Auerbach plexus)</p></div>
      </div>
      <div class="ch-step">
        <div class="ch-left"><div class="ch-dot" style="background:var(--amber);">2</div><div class="ch-line"></div></div>
        <div class="ch-body"><h4>Kontraksi Persisten</h4><p>Segmen aganglionik → tidak bisa relaksasi → konstipasi kronik, obstruksi fungsional</p></div>
      </div>
      <div class="ch-step">
        <div class="ch-left"><div class="ch-dot" style="background:var(--coral);">3</div></div>
        <div class="ch-body"><h4>Dilatasi Proksimal (Megakolon)</h4><p>Kolon proksimal melebar masif karena isi terbendung → dapat terjadi stercoral ulcers (ulkus akibat tekanan feses)</p></div>
      </div>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
      <span class="pill pi">Insidensi: 1/5000-8000 kelahiran</span>
      <span class="pill pa">Laki:Perempuan = 4:1</span>
      <span class="pill pt">Dx: biopsi rektal (tidak ada ganglion)</span>
      <span class="pill ps">Tx: reseksi segmen aganglionik</span>
    </div>
  </div>

  <!-- Divertikulosis -->
  <div class="card ca" style="margin-top:8px;">
    <h3>🫘 B. Divertikulosis Kolon</h3>
    <div class="grid2">
      <div>
        <p style="font-size:14px;color:var(--mid);"><strong>Definisi:</strong> Kantong-kantong buntu yang menonjol keluar dari lumen kolon melalui titik lemah muskularis (acquired) — hanya mukosa+submukosa, tidak ada muskularis propria</p>
        <p style="font-size:14px;color:var(--mid);margin-top:8px;"><strong>Patofisiologi:</strong> Degenerasi otot dinding kolon → lemah → tekanan intralumen mendorong mukosa keluar</p>
      </div>
      <div>
        <ul style="font-size:14px;color:var(--mid);">
          <li>Lokasi paling umum: <strong>sigmoid kolon (95%)</strong></li>
          <li>Prevalensi: 50% usia &gt;50 tahun</li>
          <li>Faktor risiko: diet rendah serat</li>
          <li>Komplikasi: divertikulitis, perdarahan, perforasi, abses, <strong>volvulus</strong> (torsi)</li>
        </ul>
      </div>
    </div>
    <div class="alert warn" style="margin-top:8px;">
      <strong>⚠️ Divertikulitis → Volvulus (Torsi)</strong>
      Divertikulosis multipel → bisa menyebabkan torsi usus (volvulus) → iskemia → nekrosis → peritonitis. Nama khas terpuntirnya usus = <strong>Volvulus</strong>.
    </div>
  </div>

  <!-- Polip -->
  <h3 style="font-family:'Libre Baskerville',serif;font-size:18px;margin:24px 0 14px;">🍄 C. Polip Kolorektal</h3>
  <div class="tw">
    <table>
      <thead><tr><th>Tipe Polip</th><th>Sifat</th><th>Karakteristik</th><th>Risiko Kanker</th></tr></thead>
      <tbody>
        <tr>
          <td><strong>Hiperplastik</strong></td>
          <td>Non-neoplastik</td>
          <td>90% semua polip epitelial; &lt;5mm; rektosigmoid</td>
          <td>❌ Hampir tidak ada</td>
        </tr>
        <tr>
          <td><strong>Juvenil</strong></td>
          <td>Hamartoma</td>
          <td>Anak &lt;5th; 1–3cm; lamina propria melebar</td>
          <td>❌ Rendah</td>
        </tr>
        <tr>
          <td><strong>Adenoma</strong></td>
          <td>Neoplastik (displasia)</td>
          <td>Tubular / tubulovilli / vilous; 20–30% sebelum 40th</td>
          <td>⚠️ 4× lebih tinggi; harus diangkat</td>
        </tr>
        <tr>
          <td><strong>FAP (Familial Adenomatous Polyposis)</strong></td>
          <td>Herediter, autosomal dominan</td>
          <td>500–2500 adenoma kolon; mutasi gen APC</td>
          <td>🔴 100% jadi karsinoma jika tidak kolektomi!</td>
        </tr>
        <tr>
          <td><strong>Peutz-Jeghers</strong></td>
          <td>Hamartoma</td>
          <td>Polip + pigmentasi melanotik mukosa & kulit; mutasi LKB1</td>
          <td>⚠️ Risiko Ca GI dan ekstra-GI</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- CRC -->
  <h3 style="font-family:'Libre Baskerville',serif;font-size:18px;margin:24px 0 14px;">🔬 D. Karsinoma Kolorektal (CRC)</h3>
  <div class="card" style="border:2px solid var(--danger);background:#fff5f5;">
    <h3 style="color:var(--danger);">⚠️ Fakta CRC</h3>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin:10px 0;">
      <span class="pill p-red">Kanker GI tersering</span>
      <span class="pill p-red">#2 pembunuh kanker di AS</span>
      <span class="pill pa">5% populasi AS</span>
      <span class="pill pa">134.000 kasus baru/tahun</span>
      <span class="pill pc">98% adalah adenokarsinoma</span>
      <span class="pill pi">80% usia &gt;60 tahun</span>
    </div>
    <div class="grid2">
      <div>
        <p style="font-size:13.5px;font-weight:600;margin-bottom:6px;">Faktor Risiko Genetik:</p>
        <ul style="font-size:13.5px;color:var(--mid);">
          <li>FAP (mutasi APC)</li>
          <li>HNPCC / Lynch syndrome (mutasi DNA mismatch repair)</li>
          <li>Ulcerative colitis / Crohn disease lama</li>
          <li>Riwayat keluarga CRC</li>
        </ul>
      </div>
      <div>
        <p style="font-size:13.5px;font-weight:600;margin-bottom:6px;">Faktor Risiko Lingkungan:</p>
        <ul style="font-size:13.5px;color:var(--mid);">
          <li>Diet rendah serat, tinggi lemak</li>
          <li>Tinggi karbohidrat olahan</li>
          <li>Obesitas, DM tipe 2</li>
          <li>Merokok, alkohol</li>
        </ul>
      </div>
    </div>
  </div>
  <div class="grid2" style="margin-top:8px;">
    <div class="card cc">
      <h3>📍 Gejala Klinis (Lokasi-Tergantung)</h3>
      <ul>
        <li><strong>Lesi kanan (kolon asendens):</strong> fatigue, anemia defisiensi besi, perdarahan tersembunyi — sering terdeteksi terlambat</li>
        <li><strong>Lesi kiri (kolon desendens/rektum):</strong> perubahan kebiasaan BAB, feses seperti pensil, perdarahan rektum nyata, nyeri kolik kiri bawah</li>
        <li>Penyebaran: ekstensi langsung, limfatik, hematogen (hati, paru, tulang)</li>
      </ul>
    </div>
    <div class="card ci">
      <h3>🧬 Jalur Karsinogenesis CRC</h3>
      <ul>
        <li><strong>Chromosomal Instability (CIN):</strong> mutasi APC → aktivasi Wnt → akumulasi mutasi bertahap (adenoma-karsinoma)</li>
        <li><strong>Microsatellite Instability (MSI):</strong> Lynch/HNPCC → defek DNA mismatch repair</li>
        <li><strong>CIMP pathway:</strong> hipermetilasi promoter gen supresor tumor</li>
      </ul>
    </div>
  </div>
</section>

