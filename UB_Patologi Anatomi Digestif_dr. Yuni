<!-- 6. ANUS & HEMOROID -->
<!-- ═══════════════════════════════ -->
<section id="anus">
  <div class="sec-head">
    <div class="sec-num">06</div>
    <div class="sec-info">
      <h2>Patologi Anus — Hemoroid</h2>
      <p>Dilatasi varises pleksus hemoroidalis</p>
    </div>
  </div>

  <div class="grid2">
    <div class="card ct">
      <h3>🩸 Hemoroid Internal</h3>
      <ul>
        <li>Di <strong>atas linea dentata</strong> — epitel intestinal (kolumnar)</li>
        <li>Lebih jarang nyeri (tidak ada somatic innervation)</li>
        <li>Gejala: perdarahan (darah merah segar setelah BAB), prolaps</li>
        <li>Stadium I–IV berdasarkan derajat prolaps</li>
      </ul>
    </div>
    <div class="card cr">
      <h3>🩸 Hemoroid Eksternal</h3>
      <ul>
        <li>Di <strong>bawah linea dentata</strong> — epitel skuamosa berlapis (seperti kulit)</li>
        <li>Lebih nyeri karena somatic innervation</li>
        <li>Bisa trombosis → nyeri hebat, massa keras biru</li>
        <li>Risiko lebih buruk — epitel ganda (intestinal + skuamosa)</li>
      </ul>
    </div>
  </div>
  <div class="card ca" style="margin-top:4px;">
    <h3>⚡ Patofisiologi Hemoroid</h3>
    <div class="chain" style="margin-top:12px;">
      <div class="ch-step">
        <div class="ch-left"><div class="ch-dot" style="background:var(--sage);">→</div><div class="ch-line"></div></div>
        <div class="ch-body"><h4>Faktor Predisposisi</h4><p>Konstipasi kronik, kehamilan, hipertensi porta → peningkatan tekanan vena</p></div>
      </div>
      <div class="ch-step">
        <div class="ch-left"><div class="ch-dot" style="background:var(--amber);">→</div><div class="ch-line"></div></div>
        <div class="ch-body"><h4>Dilatasi Varises</h4><p>Vena pleksus hemoroidalis melebar (angiektasia) → dinding tipis, rapuh</p></div>
      </div>
      <div class="ch-step">
        <div class="ch-left"><div class="ch-dot" style="background:var(--danger);">→</div></div>
        <div class="ch-body"><h4>Perforasi / Perdarahan</h4><p>Dinding pecah → perdarahan segar (hematochezia) atau trombosis</p></div>
      </div>
    </div>
  </div>
</section>

